<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Just Like A Whisper — Season One</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Inter:wght@300;400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css" />
</head>
<body class="theme-light">

    <div class="whisper-frame">

        <header class="whisper-header">
            <div class="title-wrap">
                <h1 class="book-title">Just Like A Whisper</h1>
                <p class="book-subtitle">Season One · by Zeeshan Khan</p>
            </div>
            <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
                <span class="theme-icon">☾</span>
            </button>
        </header>

        <main class="whisper-main">
            <div id="pages-container" class="pages-container"></div>
        </main>

        <footer class="whisper-footer">
            <button id="prev-btn" class="nav-btn" aria-label="Previous page">←</button>

            <div class="page-indicator">
                <span id="page-current">1</span>
                <span class="page-divider">/</span>
                <span id="page-total">25</span>
            </div>

            <button id="next-btn" class="nav-btn" aria-label="Next page">→</button>
        </footer>

        <div class="progress-line">
            <div id="progress-fill" class="progress-fill"></div>
        </div>

    </div>

    <script src="pages.js"></script>
    <script>
        (function () {
            const container = document.getElementById('pages-container');
            const prevBtn = document.getElementById('prev-btn');
            const nextBtn = document.getElementById('next-btn');
            const currentEl = document.getElementById('page-current');
            const totalEl = document.getElementById('page-total');
            const progressFill = document.getElementById('progress-fill');
            const themeToggle = document.getElementById('theme-toggle');
            const themeIcon = themeToggle.querySelector('.theme-icon');

            let currentIndex = 0;

            const renderPage = (index) => {
                const page = pages[index];
                if (!page) return;

                const wrapper = document.createElement('article');
                wrapper.className = 'page';
                wrapper.id = 'page-' + (index + 1);

                if (index === 0) wrapper.classList.add('cover-page');
                if (index === pages.length - 1) wrapper.classList.add('outro-page');

                const title = document.createElement('h2');
                title.className = 'page-title';
                title.textContent = page.title;

                const content = document.createElement('div');
                content.className = 'page-content';
                content.textContent = page.content;

                wrapper.appendChild(title);
                wrapper.appendChild(content);

                container.innerHTML = '';
                container.appendChild(wrapper);

                currentEl.textContent = index + 1;
                totalEl.textContent = pages.length;
                progressFill.style.width = (((index + 1) / pages.length) * 100) + '%';

                prevBtn.disabled = index === 0;
                nextBtn.disabled = index === pages.length - 1;

                window.scrollTo({ top: 0, behavior: 'smooth' });
            };

            const goPrev = () => {
                if (currentIndex > 0) {
                    currentIndex--;
                    renderPage(currentIndex);
                }
            };

            const goNext = () => {
                if (currentIndex < pages.length - 1) {
                    currentIndex++;
                    renderPage(currentIndex);
                }
            };

            prevBtn.addEventListener('click', goPrev);
            nextBtn.addEventListener('click', goNext);

            document.addEventListener('keydown', (e) => {
                if (e.key === 'ArrowLeft') goPrev();
                if (e.key === 'ArrowRight') goNext();
            });

            themeToggle.addEventListener('click', () => {
                const isDark = document.body.classList.toggle('theme-dark');
                document.body.classList.toggle('theme-light', !isDark);
                themeIcon.textContent = isDark ? '☀' : '☾';
            });

            if (pages && pages.length) {
                renderPage(0);
            }
        })();
    </script>

</body>
</html>
