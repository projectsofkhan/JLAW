<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Just Like A Whisper — Season One</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Inter:wght@300;400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css" />
</head>
<body class="theme-light">

    <div class="whisper-frame">

        <header class="whisper-header">
            <div class="title-wrap">
                <h1 class="book-title">Just Like A Whisper</h1>
                <p class="book-subtitle">Season One · by Zeeshan Khan</p>
            </div>
            <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
                <span class="theme-icon">☾</span>
            </button>
        </header>

        <main class="whisper-main">
            <div id="pages-container" class="pages-container"></div>
        </main>

        <footer class="whisper-footer">
            <button id="prev-btn" class="nav-btn" aria-label="Previous page">←</button>
            <div class="page-indicator">
                <span id="page-current">1</span>
                <span class="page-divider">/</span>
                <span id="page-total">25</span>
            </div>
            <button id="next-btn" class="nav-btn" aria-label="Next page">→</button>
        </footer>

        <div class="progress-line">
            <div id="progress-fill" class="progress-fill"></div>
        </div>

    </div>

    <script src="pages.js"></script>
    <script src="script.js"></script>

</body>
</html>
